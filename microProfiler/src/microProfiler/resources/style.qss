/* ═══════════════════════════════════════════════════════════════════════════
   microMax Desktop Dark Theme — shared by microProfiler and microVis.

   This file is duplicated verbatim in both packages (each app keeps its own
   copy of resources/style.qss; there is NO shared resource file). Keep the
   two copies in sync. Palette, typography and control rules are constrained
   by the "GUI style conventions" section of AGENTS.md.

   Flat control style: rounded boxes carry the raised surface; inputs are
   neutral dark blocks with NO visible border; buttons are thin-outline
   transparent blocks with accent text — ONE style everywhere (the Data-page
   Browse button is the reference), no primary/secondary/danger variants.

   Scale: window/title 11pt, panel content 9pt, auxiliary text 8pt.
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Global Defaults ────────────────────────────────────────────────────── */
QWidget {
    background-color: #252536;
    color: #e0e0e0;
    font-family: "Segoe UI", "SF Pro Display", sans-serif;
    font-size: 11pt;
}

QMainWindow {
    background-color: #1e1e2e;
}

QMainWindow::separator {
    background-color: #333333;
    width: 1px;
    height: 1px;
}

/* ── Titleless Panel Box ────────────────────────────────────────────────── */
/* A group of controls inside one rounded surface (no title, no border). */
QWidget[class="panel-box"] {
    background-color: #2d2d44;
    border: none;
    border-radius: 8px;
}

/* ── Push Buttons ───────────────────────────────────────────────────────── */
/* ONE button style everywhere (the microProfiler Input "Browse..." button is
   the reference): transparent thin-outline block with accent text. Inside a
   box the box colour shows through, on a page the page colour shows through.
   Hover highlights the BORDER (no fill). There are NO primary/secondary/
   danger variants — the only freedom is the button length (text width). */
QPushButton {
    background-color: transparent;
    color: #7a9aaa;
    border: 1px solid #444455;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 9pt;
    font-weight: normal;
}

QPushButton:hover {
    border-color: #5a8a9a;
    background-color: transparent;
}

QPushButton:pressed {
    border-color: #5a8a9a;
    background-color: rgba(90, 138, 154, 0.12);
}

QPushButton:disabled {
    color: #555555;
    border-color: #2a2a3a;
    background-color: transparent;
}

QPushButton:checked {
    border-color: #5a8a9a;
    background-color: transparent;
}

/* ── Group Box (Card Style) ─────────────────────────────────────────────── */
QGroupBox {
    background-color: #2d2d44;
    border: none;
    border-radius: 8px;
    margin-top: 8px;
    padding: 8px 8px 12px 8px;
    padding-top: 16px;
    font-weight: bold;
}

/* Flat variant: no box of its own — used for the microProfiler Filter and
   for block-container step panels, where each block is its own box. */
QGroupBox[class="flat"] {
    background-color: transparent;
    border: none;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    color: #5a8a9a;
    font-size: 11pt;
    background-color: transparent;
}

QGroupBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #666666;
    background-color: transparent;
}

QGroupBox::indicator:checked {
    background-color: #5a8a9a;
    border-color: #5a8a9a;
}

QGroupBox::indicator:hover {
    border-color: #888888;
}

QGroupBox::indicator:checked:hover {
    background-color: #6a9aaa;
}

/* ── Text Inputs ────────────────────────────────────────────────────────── */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #1e1e2e;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    color: #e0e0e0;
    selection-background-color: #5a8a9a;
    selection-color: #1e1e2e;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #5a8a9a;
}

/* Data entry is typed directly: every spin box hides its up/down arrows. */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 0px;
    height: 0px;
    border: none;
}

QSpinBox[class="sidebar-spin"], QDoubleSpinBox[class="sidebar-spin"] {
    color: #888888;
    font-size: 9pt;
    padding: 2px 4px;
    border-radius: 4px;
}

QSpinBox[class="sidebar-spin"]:focus, QDoubleSpinBox[class="sidebar-spin"]:focus {
    border-color: #5a8a9a;
}

/* ── Combo Box ──────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #1e1e2e;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    color: #e0e0e0;
    min-width: 80px;
}

QComboBox:focus {
    border-color: #5a8a9a;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #e0e0e0;
}

QComboBox QAbstractItemView {
    background-color: #2d2d44;
    border: 1px solid #333333;
    border-radius: 4px;
    selection-background-color: #5a8a9a;
    selection-color: #1e1e2e;
    color: #e0e0e0;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 6px 10px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #3a3a52;
}

/* ── Progress Bar ───────────────────────────────────────────────────────── */
QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #1e1e2e;
    height: 22px;
    text-align: center;
    color: #e0e0e0;
    font-size: 10pt;
}

QProgressBar::chunk {
    background-color: #5a8a9a;
    border-radius: 6px;
}

QProgressBar[class="error"]::chunk {
    background-color: #f04770;
}

QProgressBar[class="success"]::chunk {
    background-color: #06d6a0;
}

/* ── Scroll Area ────────────────────────────────────────────────────────── */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:horizontal {
    background-color: #1e1e2e;
    height: 8px;
    border-radius: 4px;
}

QScrollBar:vertical {
    background-color: #1e1e2e;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal, QScrollBar::handle:vertical {
    background-color: #444444;
    border-radius: 4px;
    min-height: 30px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover, QScrollBar::handle:vertical:hover {
    background-color: #555555;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ── Status Bar ─────────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #1e1e2e;
    border-top: 1px solid #333333;
    color: #e0e0e0;
    padding: 2px 8px;
}

QStatusBar QLabel {
    background-color: transparent;
    color: #888888;
}

QStatusBar QPushButton {
    padding: 4px 12px;
    font-size: 9pt;
}

QStatusBar QProgressBar {
    height: 16px;
    min-width: 200px;
    max-width: 350px;
}

/* Inline progress/status line inside the main window (microProfiler). */
QLabel[class="status-bar"] {
    background-color: transparent;
    color: #888888;
    font-size: 8pt;
}

/* ── Plain Text Edit (Log) ──────────────────────────────────────────────── */
QPlainTextEdit {
    background-color: #1e1e2e;
    border: 1px solid #333333;
    border-radius: 6px;
    color: #e0e0e0;
    font-family: "Consolas", "SF Mono", "Menlo", monospace;
    font-size: 10pt;
    padding: 8px;
}

QPlainTextEdit[class="log-panel"] {
    border-top: 1px solid #333333;
    border-radius: 0;
}

/* ── Check Box ──────────────────────────────────────────────────────────── */
QCheckBox {
    background-color: transparent;
    spacing: 8px;
    color: #e0e0e0;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #555555;
    border-radius: 4px;
    background-color: #1e1e2e;
}

QCheckBox::indicator:checked {
    border-color: #5a8a9a;
    background-color: rgba(90, 138, 154, 0.2);
}

QCheckBox::indicator:hover {
    border-color: #888888;
}

QCheckBox::indicator:checked:hover {
    border-color: #6a9aaa;
    background-color: rgba(90, 138, 154, 0.3);
}

/* Facet list (Data page): item checkboxes need a clearly visible frame. */
QListWidget::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid #888888;
    border-radius: 4px;
    background-color: #1e1e2e;
}

QListWidget::indicator:checked {
    border-color: #5a8a9a;
    background-color: rgba(90, 138, 154, 0.4);
}

/* ── Labels ─────────────────────────────────────────────────────────────── */
QLabel {
    background-color: transparent;
    color: #e0e0e0;
}

QLabel[class="placeholder"] {
    color: #666666;
    font-style: italic;
}

QLabel[class="muted"] {
    color: #888888;
}

QLabel[class="success"] {
    color: #06d6a0;
    font-weight: bold;
}

QLabel[class="error"] {
    color: #f04770;
}

QLabel[class="hint"] {
    color: #666666;
    font-size: 8pt;
    font-style: italic;
    padding-left: 4px;
}

QLabel[class="section-title"] {
    color: #e0e0e0;
    font-weight: bold;
    font-size: 11pt;
    padding-top: 8px;
    padding-bottom: 4px;
}

QLabel[class="info-card"] {
    background-color: #2d2d44;
    border-radius: 6px;
    padding: 8px 12px;
    color: #e0e0e0;
}

/* ── List Widget ────────────────────────────────────────────────────────── */
QListWidget {
    background-color: #1e1e2e;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 4px;
}

QListWidget::item {
    padding: 4px 8px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #5a8a9a;
    color: #1e1e2e;
}

/* ── Splitter ───────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #333333;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ── Horizontal Separators ──────────────────────────────────────────────── */
QFrame[class="separator"] {
    background-color: #333333;
    max-height: 1px;
    border: none;
}

/* ── Tool Tip ───────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #2d2d44;
    color: #e0e0e0;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 8pt;
}

/* ── Sidebar (both apps) ────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #1e1e2e;
    border-right: 1px solid #333333;
}

QWidget[active="true"] {
    background-color: #2d2d44;
    border-left: 3px solid #5a8a9a;
}

QWidget[active="false"] {
    background-color: transparent;
    border-left: 3px solid transparent;
}

QLabel[class="sidebar-icon"] {
    font-size: 14pt;
    color: #888888;
    background-color: transparent;
}

QWidget[active="true"] QLabel[class="sidebar-icon"] {
    color: #5a8a9a;
}

QLabel[class="sidebar-label"] {
    background-color: transparent;
    font-size: 10pt;
    color: #888888;
}

QWidget[active="true"] QLabel[class="sidebar-label"] {
    color: #e0e0e0;
}

QWidget[class="sidebar-divider"] {
    background-color: #333333;
    max-height: 1px;
    margin: 4px 8px;
}

/* Sidebar footer buttons: the shared button look plus a small side inset so
   Run All / Cancel do not touch the sidebar edges. */
QPushButton[class="sidebar-footer-btn"] {
    margin: 3px 6px;
}

/* ── Block Card (repeatable blocks) ─────────────────────────────────────── */
/* Each repeatable block is its own rounded box; block-container panels are
   flat (QGroupBox[class="flat"]) so there is exactly one box level. */
QWidget[class="block-card"] {
    background-color: #2d2d44;
    border: none;
    border-radius: 8px;
    padding: 8px 10px;
}

QWidget[class="card-inner"] {
    background-color: transparent;
}

/* ── Tab Widget ─────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background-color: #252536;
}

QTabBar::tab {
    background-color: #1e1e2e;
    color: #888888;
    padding: 8px 20px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: #e0e0e0;
    border-bottom: 2px solid #5a8a9a;
}

QTabBar::tab:hover:!selected {
    color: #cccccc;
    background-color: #2d2d44;
}

/* ── Nav Tab (rotated sidebar labels, microVis) ─────────────────────────── */
QLabel[class="nav-tab"] {
    background-color: transparent;
    color: #888888;
    border: none;
    border-left: 3px solid transparent;
    font-size: 9pt;
    padding: 6px 2px;
}

QLabel[class="nav-tab"][active="true"] {
    color: #e0e0e0;
    border-left: 3px solid #5a8a9a;
    background-color: #2d2d44;
}

QLabel[class="nav-tab"]:hover {
    color: #cccccc;
}

/* ── Data page: one 9pt scale across the whole page ─────────────────────── */
QWidget#data-view QLabel,
QWidget#data-view QLineEdit,
QWidget#data-view QComboBox,
QWidget#data-view QSpinBox,
QWidget#data-view QDoubleSpinBox,
QWidget#data-view QCheckBox,
QWidget#data-view QPushButton {
    font-size: 9pt;
}
